// LabVault — Lab Management System (Schema v2)
// Multi-tenant schema (every domain table scoped by organizationId)
// NOTE: SQLite provider does not support enums — status/role fields are Strings
// validated against constants in src/lib/constants.ts.
// PostgreSQL path: scripts/use-postgres.sh (see docs/database.md)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("PRO") // FREE | PRO | ENTERPRISE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  labs                  Lab[]
  equipment             Equipment[]
  reservations          Reservation[]
  checkouts             Checkout[]
  inventoryItems        InventoryItem[]
  inventoryTransactions InventoryTransaction[]
  chemicals             Chemical[]
  maintenance           MaintenanceRecord[]
  equipmentEvents       EquipmentEvent[]
  calibrationRecords    CalibrationRecord[]
  experiments           Experiment[]
  sessions              LabSession[]
  attendance            Attendance[]
  grades                Grade[]
  incidents             Incident[]
  vendors               Vendor[]
  purchaseRequests      PurchaseRequest[]
  purchaseOrders        PurchaseOrder[]
  goodsReceipts         GoodsReceipt[]
  departments           Department[]
  courses               Course[]
  documents             Document[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  passwordResetTokens   PasswordResetToken[]
  purchaseOrderItems    PurchaseOrderItem[]
  goodsReceiptItems     GoodsReceiptItem[]

  @@map("organizations")
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String   @unique
  passwordHash   String
  role           String   @default("STUDENT") // ADMIN | LAB_MANAGER | INSTRUCTOR | TECHNICIAN | STUDENT
  status         String   @default("ACTIVE") // ACTIVE | SUSPENDED
  phone          String?
  department     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  managedLabs           Lab[]                  @relation("LabManager")
  reservations          Reservation[]
  checkouts             Checkout[]
  reportedIncidents     Incident[]             @relation("IncidentReporter")
  experiments           Experiment[]           @relation("ExperimentInstructor")
  instructedSessions    LabSession[]           @relation("SessionInstructor")
  instructedCourses     Course[]               @relation("CourseInstructor")
  issuedCheckouts       Checkout[]             @relation("CheckoutIssuer")
  attendance            Attendance[]
  maintenanceJobs       MaintenanceRecord[]    @relation("Technician")
  purchaseRequests      PurchaseRequest[]      @relation("RequestedBy")
  createdOrders         PurchaseOrder[]        @relation("OrderCreator")
  goodsReceipts         GoodsReceipt[]
  inventoryTransactions InventoryTransaction[] @relation("InventoryActor")
  equipmentEvents       EquipmentEvent[]       @relation("EventActor")
  gradedEntries         Grade[]                @relation("Grader")
  uploadedDocuments     Document[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  passwordResetTokens   PasswordResetToken[]
  grades                Grade[]

  @@index([organizationId])
  @@map("users")
}

model PasswordResetToken {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Department {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  labs         Lab[]
  courses      Course[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("departments")
}

model Lab {
  id             String   @id @default(cuid())
  organizationId String
  departmentId   String?
  name           String
  code           String
  location       String?
  capacity       Int      @default(0)
  status         String   @default("ACTIVE") // ACTIVE | MAINTENANCE | CLOSED
  description    String?
  managerId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department        Department?            @relation(fields: [departmentId], references: [id])
  manager           User?                  @relation("LabManager", fields: [managerId], references: [id])
  equipment         Equipment[]
  inventoryItems    InventoryItem[]
  chemicals         Chemical[]
  experiments       Experiment[]
  incidents         Incident[]
  sessions          LabSession[]
  incomingTransfers InventoryTransaction[] @relation("TransferTarget")

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("labs")
}

model Course {
  id             String   @id @default(cuid())
  organizationId String
  departmentId   String?
  code           String
  title          String
  description    String?
  instructorId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id])
  instructor   User?        @relation("CourseInstructor", fields: [instructorId], references: [id])
  experiments  Experiment[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("courses")
}

model Equipment {
  id             String    @id @default(cuid())
  organizationId String
  labId          String
  name           String
  code           String
  category       String    @default("GENERAL") // GENERAL | INSTRUMENT | COMPUTING | SAFETY | OPTICS | ELECTRICAL
  status         String    @default("AVAILABLE") // AVAILABLE | IN_USE | UNDER_MAINTENANCE | RETIRED
  condition      String    @default("GOOD") // EXCELLENT | GOOD | FAIR | POOR
  serialNumber   String?
  manufacturer   String?
  purchaseDate   DateTime?
  warrantyUntil  DateTime?
  price          Float     @default(0)
  qrToken        String    @unique @default(cuid())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lab                Lab                 @relation(fields: [labId], references: [id])
  reservations       Reservation[]
  checkouts          Checkout[]
  maintenanceRecords MaintenanceRecord[]
  events             EquipmentEvent[]
  calibrationRecords CalibrationRecord[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([labId])
  @@index([organizationId, status])
  @@map("equipment")
}

model EquipmentEvent {
  id             String   @id @default(cuid())
  organizationId String
  equipmentId    String
  type           String // CREATED | PURCHASED | RECEIVED | ASSIGNED | RESERVED | CHECKED_OUT | RETURNED | MAINTENANCE_STARTED | MAINTENANCE_COMPLETED | CALIBRATION_STARTED | CALIBRATION_COMPLETED | DAMAGED | REPAIRED | RETIRED | STATUS_CHANGED
  previousStatus String?
  newStatus      String?
  notes          String?
  actorId        String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  equipment    Equipment    @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  actor        User?        @relation("EventActor", fields: [actorId], references: [id])

  @@index([organizationId, equipmentId, createdAt])
  @@map("equipment_events")
}

model Reservation {
  id             String    @id @default(cuid())
  organizationId String
  equipmentId    String
  userId         String
  startAt        DateTime
  endAt          DateTime
  status         String    @default("PENDING") // PENDING | APPROVED | ACTIVE | COMPLETED | REJECTED | CANCELLED | NO_SHOW
  purpose        String?
  checkedInAt    DateTime?
  activatedAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  equipment    Equipment    @relation(fields: [equipmentId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([equipmentId, startAt, endAt])
  @@index([organizationId, status])
  @@map("reservations")
}

model Checkout {
  id             String    @id @default(cuid())
  organizationId String
  equipmentId    String
  userId         String
  checkedOutAt   DateTime  @default(now())
  dueAt          DateTime
  checkedInAt    DateTime?
  status         String    @default("ACTIVE") // ACTIVE | RETURNED | OVERDUE
  conditionOut   String?
  conditionIn    String?
  accessoriesOut String?
  accessoriesIn  String?
  issuedById     String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  equipment    Equipment    @relation(fields: [equipmentId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  issuedBy     User?        @relation("CheckoutIssuer", fields: [issuedById], references: [id])

  @@index([organizationId])
  @@index([equipmentId])
  @@index([organizationId, status])
  @@map("checkouts")
}

model InventoryItem {
  id             String   @id @default(cuid())
  organizationId String
  labId          String
  name           String
  sku            String
  category       String   @default("CONSUMABLE") // CONSUMABLE | SPARE | STATIONERY | SAFETY
  quantity       Int      @default(0)
  unit           String   @default("pcs")
  minQuantity    Int      @default(5)
  location       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lab                Lab                    @relation(fields: [labId], references: [id])
  transactions       InventoryTransaction[]
  purchaseOrderItems PurchaseOrderItem[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([labId])
  @@index([organizationId, quantity])
  @@map("inventory_items")
}

model InventoryTransaction {
  id              String   @id @default(cuid())
  organizationId  String
  itemId          String
  type            String // RECEIPT | ISSUE | RETURN | TRANSFER | ADJUSTMENT | DAMAGE | EXPIRY
  quantity        Int // positive except ADJUSTMENT (signed)
  previousBalance Int
  newBalance      Int
  transferToLabId String?
  reason          String?
  referenceType   String?
  referenceId     String?
  performedById   String?
  createdAt       DateTime @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item          InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  transferToLab Lab?          @relation("TransferTarget", fields: [transferToLabId], references: [id])
  performedBy   User?         @relation("InventoryActor", fields: [performedById], references: [id])

  @@index([organizationId, createdAt])
  @@index([itemId, createdAt])
  @@map("inventory_transactions")
}

model Chemical {
  id              String    @id @default(cuid())
  organizationId  String
  labId           String
  name            String
  casNumber       String?
  batchNumber     String?
  supplier        String?
  quantity        Float     @default(0)
  unit            String    @default("mL")
  hazardClass     String    @default("LOW") // LOW | FLAMMABLE | CORROSIVE | TOXIC | REACTIVE
  expiryDate      DateTime?
  storageLocation String?
  sdsDocumentId   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lab          Lab          @relation(fields: [labId], references: [id])

  @@index([organizationId])
  @@index([labId])
  @@index([organizationId, expiryDate])
  @@map("chemicals")
}

model MaintenanceRecord {
  id             String    @id @default(cuid())
  organizationId String
  equipmentId    String
  technicianId   String?
  type           String    @default("PREVENTIVE") // PREVENTIVE | CORRECTIVE | EMERGENCY | CALIBRATION
  priority       String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status         String    @default("OPEN") // OPEN | ASSIGNED | IN_PROGRESS | WAITING_FOR_PARTS | COMPLETED | CANCELLED
  title          String    @default("Maintenance work order")
  issue          String?
  scheduledAt    DateTime
  startedAt      DateTime?
  completedAt    DateTime?
  downtimeHours  Float?
  laborCost      Float     @default(0)
  partsCost      Float     @default(0)
  cost           Float     @default(0) // total = labor + parts
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  equipment    Equipment    @relation(fields: [equipmentId], references: [id])
  technician   User?        @relation("Technician", fields: [technicianId], references: [id])

  @@index([organizationId])
  @@index([equipmentId])
  @@index([organizationId, status])
  @@map("maintenance_records")
}

model CalibrationRecord {
  id                String   @id @default(cuid())
  organizationId    String
  equipmentId       String
  standard          String   @default("Reference standard")
  provider          String?
  lastCalibratedAt  DateTime @default(now())
  nextDueAt         DateTime
  certificateNumber String?
  result            String   @default("PENDING") // PASS | FAIL | PENDING
  deviation         Float?
  status            String   @default("VALID") // VALID | DUE_SOON | OVERDUE | FAILED
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  equipment    Equipment    @relation(fields: [equipmentId], references: [id])

  @@index([organizationId, nextDueAt])
  @@index([equipmentId])
  @@map("calibration_records")
}

model Experiment {
  id             String   @id @default(cuid())
  organizationId String
  labId          String
  courseId       String?
  instructorId   String?
  title          String
  code           String
  description    String?
  status         String   @default("ACTIVE") // DRAFT | ACTIVE | ARCHIVED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lab          Lab          @relation(fields: [labId], references: [id])
  course       Course?      @relation(fields: [courseId], references: [id])
  instructor   User?        @relation("ExperimentInstructor", fields: [instructorId], references: [id])
  sessions     LabSession[]
  grades       Grade[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("experiments")
}

model LabSession {
  id             String   @id @default(cuid())
  organizationId String
  experimentId   String
  labId          String?
  instructorId   String?
  title          String
  scheduledAt    DateTime
  durationMin    Int      @default(90)
  status         String   @default("SCHEDULED") // SCHEDULED | IN_PROGRESS | COMPLETED | CANCELLED
  room           String?
  remarks        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  experiment   Experiment   @relation(fields: [experimentId], references: [id])
  lab          Lab?         @relation(fields: [labId], references: [id])
  instructor   User?        @relation("SessionInstructor", fields: [instructorId], references: [id])
  attendance   Attendance[]
  grades       Grade[]

  @@index([organizationId])
  @@index([experimentId])
  @@index([organizationId, scheduledAt])
  @@map("lab_sessions")
}

model Attendance {
  id             String   @id @default(cuid())
  organizationId String
  sessionId      String
  userId         String?
  studentName    String
  status         String   @default("PRESENT") // PRESENT | ABSENT | LATE
  markedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session      LabSession   @relation(fields: [sessionId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([sessionId])
  @@map("attendance")
}

model Grade {
  id             String   @id @default(cuid())
  organizationId String
  sessionId      String
  experimentId   String?
  userId         String?
  studentName    String
  score          Float
  maxScore       Float    @default(100)
  remarks        String?
  gradedById     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session      LabSession   @relation(fields: [sessionId], references: [id])
  experiment   Experiment?  @relation(fields: [experimentId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])
  gradedBy     User?        @relation("Grader", fields: [gradedById], references: [id])

  @@index([organizationId, sessionId])
  @@map("grades")
}

model Incident {
  id                String    @id @default(cuid())
  organizationId    String
  labId             String
  reportedById      String?
  type              String    @default("OTHER") // EQUIPMENT_DAMAGE | SAFETY_VIOLATION | SPILL | INJURY | POWER_FAILURE | FIRE | MISSING_ASSET | OTHER
  title             String
  description       String?
  severity          String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status            String    @default("OPEN") // OPEN | INVESTIGATING | CONTAINED | RESOLVED | CLOSED
  rootCause         String?
  correctiveAction  String?
  preventiveAction  String?
  responsiblePerson String?
  closureNotes      String?
  containedAt       DateTime?
  resolvedAt        DateTime?
  closedAt          DateTime?
  occurredAt        DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lab          Lab          @relation(fields: [labId], references: [id])
  reportedBy   User?        @relation("IncidentReporter", fields: [reportedById], references: [id])

  @@index([organizationId])
  @@index([labId])
  @@index([organizationId, status])
  @@map("incidents")
}

model Vendor {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  contactEmail   String?
  phone          String?
  address        String?
  category       String   @default("EQUIPMENT") // EQUIPMENT | CHEMICALS | CONSUMABLES | SERVICES
  rating         Float    @default(4.0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]

  @@index([organizationId])
  @@map("vendors")
}

model PurchaseRequest {
  id             String   @id @default(cuid())
  organizationId String
  vendorId       String?
  requestedById  String?
  itemName       String
  quantity       Int      @default(1)
  estimatedCost  Float    @default(0)
  status         String   @default("SUBMITTED") // DRAFT | SUBMITTED | APPROVED | REJECTED | ORDERED | RECEIVED
  justification  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor       Vendor?         @relation(fields: [vendorId], references: [id])
  requestedBy  User?           @relation("RequestedBy", fields: [requestedById], references: [id])
  orders       PurchaseOrder[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("purchase_requests")
}

model PurchaseOrder {
  id                String    @id @default(cuid())
  organizationId    String
  poNumber          String
  vendorId          String?
  purchaseRequestId String?
  createdById       String?
  status            String    @default("DRAFT") // DRAFT | ORDERED | PARTIALLY_RECEIVED | RECEIVED | CANCELLED
  orderedAt         DateTime?
  expectedAt        DateTime?
  receivedAt        DateTime?
  totalCost         Float     @default(0)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor          Vendor?             @relation(fields: [vendorId], references: [id])
  purchaseRequest PurchaseRequest?    @relation(fields: [purchaseRequestId], references: [id])
  createdBy       User?               @relation("OrderCreator", fields: [createdById], references: [id])
  items           PurchaseOrderItem[]
  goodsReceipts   GoodsReceipt[]

  @@unique([organizationId, poNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String  @id @default(cuid())
  organizationId   String
  orderId          String
  inventoryItemId  String?
  name             String
  quantity         Int
  unitCost         Float   @default(0)
  receivedQuantity Int     @default(0)

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order             PurchaseOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventoryItem     InventoryItem?     @relation(fields: [inventoryItemId], references: [id])
  goodsReceiptItems GoodsReceiptItem[]

  @@index([organizationId, orderId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id             String   @id @default(cuid())
  organizationId String
  orderId        String
  receivedById   String?
  invoiceNumber  String?
  notes          String?
  receivedAt     DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        PurchaseOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  receivedBy   User?              @relation(fields: [receivedById], references: [id])
  items        GoodsReceiptItem[]

  @@index([organizationId])
  @@index([orderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id             String  @id @default(cuid())
  organizationId String
  receiptId      String
  orderItemId    String
  quantity       Int
  condition      String  @default("GOOD") // EXCELLENT | GOOD | FAIR | POOR | DAMAGED
  notes          String?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receipt      GoodsReceipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  orderItem    PurchaseOrderItem @relation(fields: [orderItemId], references: [id])

  @@index([organizationId, receiptId])
  @@map("goods_receipt_items")
}

model Document {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  mimeType       String
  size           Int
  entityType     String // EQUIPMENT | LAB | CHEMICAL | INCIDENT | VENDOR | PURCHASE_ORDER | CALIBRATION
  entityId       String
  storagePath    String
  uploadedById   String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id])

  @@index([organizationId, entityType, entityId])
  @@map("documents")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  metadata       String?
  requestId      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  title          String
  body           String?
  type           String   @default("INFO") // INFO | WARNING | SUCCESS | ERROR
  entityType     String?
  entityId       String?
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId, read])
  @@map("notifications")
}
